# GymProgress - Variables de entorno
# Copia este archivo a .env.local y rellena los valores

# Supabase (obtener en Dashboard > Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: versión de la app para cache busting
VITE_APP_VERSION=1.0.0

# URL base de la aplicación (para enlaces de recuperación de contraseña, etc.)
# En desarrollo: http://localhost:5173
# En producción: https://gymprogress-seven.vercel.app
# Si no se define, se usa un valor por defecto según el entorno
VITE_APP_URL=http://localhost:5173